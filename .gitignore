# --- секреты: ничего из этого не должно попасть в репозиторий ---
.env
.env.*
!.env.example

# JSON-ключи сервисных аккаунтов Google (glossary.example.json — не ключ, он нужен)
*service-account*.json
*credentials*.json
*-key.json
key*.json
gcp-*.json
application_default_credentials.json

# прочие форматы ключей
*.pem
*.p12
*.pfx

# --- окружение и артефакты ---
.venv/
venv/
__pycache__/
*.py[cod]
.Python

