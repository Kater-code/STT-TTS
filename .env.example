# OpenAI — используется и для Whisper (STT), и для перевода
OPENAI_API_KEY=sk-...

# Google Cloud TTS (голоса fil-PH). Путь к service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ElevenLabs — только если TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# --- необязательные переопределения ---
